{
  "expo": {
    "name": "Spendes",
    "slug": "spendes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spendes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendes.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Spendes uses your contacts so you can add friends and group members to split expenses with.",
        "LSApplicationQueriesSchemes": [
          "upi",
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "bhim",
          "credpay"
        ]
      }
    },
    "android": {
      "package": "com.spendes.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Spendes uses your contacts so you can add friends and group members to split expenses with."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4F46E5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62607133-679f-4769-90d8-dee5895e4a4f"
      }
    },
    "owner": "uttamakwana"
  }
}
